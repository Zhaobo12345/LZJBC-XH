                            <td>数据来源</td>
                            <td><code>GET /api/v1/projects/:id/activities?level=xxx&page=1&size=20</code></td>
                        </tr>
                        <tr>
                            <td>分页方式</td>
                            <td>上拉加载更多，每页20条</td>
                        </tr>
                        <tr>
                            <td>排序规则</td>
                            <td>按时间倒序，最新动态在最上方</td>
                        </tr>
                        <tr>
                            <td>层级筛选</td>
                            <td>通过URL参数level传递，可选值：项目部/工作组/施工组</td>
                        </tr>
                        <tr>
                            <td>空状态</td>
                            <td>显示空状态插图，提示"暂无动态记录"</td>
                        </tr>
                        <tr>
                            <td>下拉刷新</td>
                            <td>支持下拉刷新，重新加载第一页数据</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="subsection" id="sub-11-5">
