                <table>
                    <thead>
                        <tr>
                            <th>属性</th>
                            <th>值</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>图片数量</td>
                            <td>最多9张</td>
                        </tr>
                        <tr>
                            <td>图片格式</td>
                            <td>jpg / jpeg / png / webp（与 20.3 字段规则及 <code>shared/validation.js</code> 实现一致）</td>
                        </tr>
                        <tr>
                            <td>单张大小</td>
                            <td>≤10MB（与 20.3 字段规则及 <code>shared/validation.js</code> 实现一致）</td>
                        </tr>
                        <tr>
                            <td>提交后状态</td>
                            <td>变更为"已支付"</td>
                        </tr>
