                        <div class="info-value"><a href="owner-miniapp/project-detail-completed.html" target="_blank">owner-miniapp/project-detail-completed.html</a></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">适用角色</div>
                        <div class="info-value">业主</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">页面入口</div>
