                            <td>面包屑中的层级名称</td>
                            <td>点击</td>
                            <td>导航到对应层级</td>
                        </tr>
                        <tr>
                            <td>选择器以外区域</td>
                            <td>点击</td>
                            <td>关闭下拉菜单</td>
                        </tr>
                        <tr>
                            <td rowspan="2">合同概览</td>
