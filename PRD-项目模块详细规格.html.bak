        <!-- ==================== 2. 项目列表页（服务方） ==================== -->
        <div class="section" id="page-list-service">
            <div class="section-title">
                二、项目列表页（服务方小程序）
                <span class="badge">service-miniapp/project-list.html</span>
            </div>

            <div class="subsection" id="sub-2-1">
                <div class="subsection-title">2.1 页面概述</div>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">页面名称</div>
                        <div class="info-value">项目列表页</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">页面路径</div>
                        <div class="info-value"><a href="service-miniapp/project-list.html" target="_blank">/pages/project-list/index</a></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">适用角色</div>
                        <div class="info-value">已加入的全部用户</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">页面入口</div>
                        <div class="info-value">首页"项目列表"、底部TabBar</div>
                    </div>
                </div>
            </div>

            <div class="subsection" id="sub-2-2">
                <div class="subsection-title">2.2 数据展示规则</div>
                <table>
                    <thead>
                        <tr>
                            <th>属性</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>数据范围</td>
                            <td>展示当前用户自己创建的项目和已加入的项目数据</td>
                        </tr>
                        <tr>
                            <td>自己创建的项目</td>
                            <td>当前用户作为项目发起人创建的项目，拥有项目管理权限</td>
                        </tr>
                        <tr>
                            <td>已加入的项目</td>
                            <td>当前用户被邀请加入的项目，根据默认或配置的权限展示对应内容</td>
                        </tr>
                        <tr>
                            <td>排序规则</td>
                            <td>按项目最后操作时间倒序排列</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="subsection" id="sub-2-3">
                <div class="subsection-title">2.3 页面结构</div>
                <div class="code-block">
┌─────────────────────────────────────┐
│  导航栏                              │
│  - 标题：我的项目                    │
├─────────────────────────────────────┤
│  状态Tab栏                           │
│  - 全部 | 进行中 | 已完工            │
├─────────────────────────────────────┤
│  项目卡片列表                        │
│  - 项目名称 + 状态标签               │
│  - 项目地址                          │
│  - 合同进度/任务进度统计              │
├─────────────────────────────────────┤
│  悬浮创建按钮（FAB）                  │
│  - 右下角固定位置                    │
│  - 点击跳转创建项目页                │
├─────────────────────────────────────┤
│  底部TabBar                           │
│  - 首页 | 我的项目（激活）| 消息     │
└─────────────────────────────────────┘
                </div>
            </div>

            <div class="subsection" id="sub-2-4">
                <div class="subsection-title">2.4 状态Tab切换规则</div>
                <table>
                    <thead>
                        <tr>
                            <th>属性</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Tab项</td>
                            <td>全部、进行中、已完工，共3个Tab</td>
                        </tr>
                        <tr>
                            <td>默认选中</td>
                            <td>默认选中"全部"Tab</td>
                        </tr>
                        <tr>
                            <td>选中状态</td>
                            <td>文字颜色为主色（#1890FF）、字体加粗，底部显示2px高的主色下划线（宽度与文字等宽）</td>
                        </tr>
                        <tr>
                            <td>未选中状态</td>
                            <td>文字颜色为次级文字色（#595959）、常规字重，无下划线</td>
                        </tr>
                        <tr>
                            <td>切换方式</td>
                            <td>点击Tab项即时切换，无需二次确认</td>
                        </tr>
                        <tr>
                            <td>切换动画</td>
                            <td>下划线滑块平滑过渡，过渡时长200ms</td>
                        </tr>
                        <tr>
                            <td>全部Tab</td>
                            <td>展示所有状态的项目（进行中 + 已完工），按最后操作时间倒序</td>
                        </tr>
                        <tr>
                            <td>进行中Tab</td>
                            <td>筛选状态为"进行中"的项目，按最后操作时间倒序</td>
                        </tr>
                        <tr>
                            <td>已完工Tab</td>
                            <td>筛选状态为"已完工"的项目，按完工时间倒序</td>
                        </tr>
                        <tr>
                            <td>筛选无数据</td>
                            <td>当前Tab筛选后无匹配项目时，显示筛选空状态（详见 2.7 项目列表空状态规格）</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="subsection" id="sub-2-5">
                <div class="subsection-title">2.5 项目卡片规格</div>
                <table>
                    <thead>
                        <tr>
                            <th>元素</th>
                            <th>数据来源</th>
                            <th>显示规则</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>项目名称</td>
                            <td>projects.name</td>
                            <td>完整显示</td>
                        </tr>
                        <tr>
                            <td>项目状态</td>
                            <td>projects.status</td>
                            <td>进行中（蓝色）/ 已完成（绿色）</td>
                        </tr>
                        <tr>
                            <td>项目地址</td>
                            <td>projects.address</td>
                            <td>完整地址，显示区域+详细地址</td>
                        </tr>
                        <tr>
                            <td>合同进度</td>
                            <td>已签约合同数/总合同数</td>
                            <td>进度条（绿色）</td>
                        </tr>
                        <tr>
                            <td>任务进度</td>
                            <td>已完成任务数/总任务数</td>
                            <td>进度条（蓝色）</td>
                        </tr>
                        <tr>
                            <td>点击行为</td>
                            <td>—</td>
                            <td>点击项目卡片，跳转到<a href="#page-detail-service">项目详情页（服务方小程序）</a>，携带项目ID参数</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="subsection" id="sub-2-6">
                <div class="subsection-title">2.6 悬浮创建按钮（FAB）</div>
                <table>
                    <thead>
                        <tr>
                            <th>属性</th>
                            <th>值</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>位置</td>
                            <td>默认展示，右下角固定，距离底部70px（TabBar高度+边距）</td>
                        </tr>
                        <tr>
                            <td>尺寸</td>
                            <td>56x56px，圆形</td>
                        </tr>
                        <tr>
                            <td>背景色</td>
                            <td>#1890FF</td>
                        </tr>
                        <tr>
                            <td>图标</td>
                            <td>+ 号，白色，24px</td>
                        </tr>
                        <tr>
                            <td>阴影</td>
                            <td>0 4px 12px rgba(24,144,255,0.4)</td>
                        </tr>
                        <tr>
                            <td>点击行为</td>
                            <td>点击创建入口后，若用户未认证角色，弹出轻提示弹窗，提示文案“当前操作需先完成角色认证；
认证通过后方可继续创建；”，弹窗提供两个操作：“立即认证”：跳转至认证页面；“取消”：关闭提示，返回原页面；若用户已认证则跳转到<a href="#page-create-service">创建项目页</a>。</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="subsection" id="sub-2-7">
                <div class="subsection-title">2.7 项目列表空状态规格</div>
                <table>
                    <thead>
                        <tr>
                            <th>状态类型</th>
                            <th>触发条件</th>
                            <th>展示内容</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>加载中</td>
                            <td>页面首次加载、下拉刷新、切换筛选Tab数据请求中</td>
                            <td>居中显示加载动画（旋转圆环），下方显示"加载中..."文字</td>
                        </tr>
                        <tr>
                            <td>全局空状态</td>
                            <td>当前用户尚无任何项目数据</td>
                            <td>居中显示<code>empty-project</code>类型SVG插图（100x100px），标题"暂无项目"，描述"您还没有创建任何项目，点击下方按钮开始创建"，底部操作按钮"创建项目"（点击跳转创建项目页）</td>
                        </tr>
                        <tr>
                            <td>筛选空状态</td>
                            <td>切换筛选Tab后当前条件无匹配项目（如"已完工"Tab下无数据）</td>
                            <td>居中显示<code>empty-project</code>类型SVG插图，标题"暂无相关项目"，描述根据筛选条件动态变化（如"当前筛选条件下没有进行中的项目"）</td>
                        </tr>
                        <tr>
                            <td>无网络</td>
                            <td>网络断开或请求超时</td>
                            <td>居中显示<code>no-network</code>类型SVG插图，标题"网络连接失败"，描述"请检查网络设置后重试"，底部操作按钮"重试"（点击重新发起数据请求）</td>
                        </tr>
                    </tbody>
                </table>

                <div class="note" style="margin-top: 16px;">
                    <div class="note-title">悬浮创建按钮（FAB）可见性规则</div>
                    <p><strong>有数据状态：</strong>FAB按钮正常显示，点击跳转创建项目页</p>
                    <p><strong>全局空状态：</strong>FAB按钮保持显示，同时空状态提供"创建项目"操作按钮，两者均可触发创建</p>
                    <p><strong>加载中状态：</strong>FAB按钮隐藏，避免用户在加载过程中误操作</p>
                    <p><strong>无网络状态：</strong>FAB按钮隐藏，引导用户先解决网络问题</p>
                    <p><strong>筛选空状态：</strong>筛选条件产生的空状态，FAB按钮保持显示</p>
                </div>

                <div class="note" style="margin-top: 16px; background: #E6F7FF; border-left-color: var(--primary-color);">
                    <div class="note-title" style="color: var(--primary-color);">空状态SVG插图说明</div>
                    <p>空状态插图统一使用项目内置的<code>shared/empty-state.js</code>组件，包含10种内置SVG插图。项目列表页使用的类型为<code>empty-project</code>（空项目）和<code>no-network</code>（无网络），详见 <a href="../shared/empty-state-demo.html" target="_blank" style="color: var(--primary-color);">空状态组件演示页</a>。</p>
                </div>
            </div>
        </div>

        <!-- ==================== 3. 项目详情页（服务方） ==================== -->
        <div class="section" id="page-detail-service">
            <div class="section-title">
                三、项目详情页（服务方小程序）
                <span class="badge">service-miniapp/project-detail.html</span>
            </div>

            <div class="subsection" id="sub-3-1">
                <div class="subsection-title">3.1 页面概述</div>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">页面名称</div>
                        <div class="info-value">项目详情页</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">页面路径</div>
                        <div class="info-value"><a href="service-miniapp/project-detail.html" target="_blank">/pages/project-detail/index</a></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">适用角色</div>
                        <div class="info-value">已加入的全部用户</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">页面入口</div>
                        <div class="info-value">项目列表点击项目卡片</div>
                    </div>
                </div>
            </div>

            <div class="subsection" id="sub-3-2">
                <div class="subsection-title">3.2 页面结构</div>
                <div class="code-block">
┌─────────────────────────────────────┐
│  导航栏                              │
│  - 返回 | 项目名称 | ⋯更多           │
├─────────────────────────────────────┤
│  快捷导航栏（可收起）                 │
│  - 固定按钮 + 快捷入口               │
│  - 项目信息 | 架构 | 成员 | 资料     │
│  - 对账单                            │
│  - 展开按钮                          │
├─────────────────────────────────────┤
│  层级选择器                          │
│  - 当前层级图标 + 名称 + 类型        │
│  - 面包屑导航                        │
│  - 下拉切换层级                      │
├─────────────────────────────────────┤
│  合同概览卡片                        │
│  - 签约进度：已签约X/总数Y            │
│  - 总进度：百分比                     │
│  - 合同列表（可折叠）                 │
│    * 合同名称 + 工作组 + 金额        │
│    * 进度条                          │
├─────────────────────────────────────┤
│  任务统计卡片                        │
│  - 全部任务 X/Y                      │
│  - 确认中任务 X                      │
│  - 执行中任务 X                      │
├─────────────────────────────────────┤
│  待办事项卡片                        │
│  - 待办列表（最新5条）                │
│  - 点击跳转对应页面                  │
├─────────────────────────────────────┤
│  今日动态卡片                        │
│  - 动态时间线展示                    │
│  - 动态内容 + 操作人 + 时间          │
│  - 支持图片/视频媒体展示             │
│  - 点击"展开更多"查看全部动态         │
└─────────────────────────────────────┘
                </div>
            </div>

            <div class="subsection" id="sub-3-3">
                <div class="subsection-title">3.3 快捷导航规格</div>
                <table>
                    <thead>
                        <tr>
                            <th>入口名称</th>
                            <th>图标</th>
                            <th>跳转页面</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>固定</td>
                            <td>📌</td>
                            <td>—</td>
                            <td>将当前项目固定到首页</td>
                        </tr>
                        <tr>
                            <td>项目信息</td>
                            <td>📋</td>
                            <td>project-info.html</td>
                            <td>查看项目基本信息</td>
                        </tr>
                        <tr>
                            <td>架构</td>
                            <td>🏗️</td>
                            <td>architecture.html</td>
                            <td>查看项目架构树</td>
                        </tr>
                        <tr>
                            <td>成员</td>
                            <td>👥</td>
                            <td>member.html</td>
                            <td>查看项目成员</td>
                        </tr>
                        <tr>
                            <td>资料</td>
                            <td>📁</td>
                            <td>project-files.html</td>
                            <td>查看项目文件</td>
                        </tr>
                        <tr>
                            <td>对账单</td>
                            <td>💰</td>
                            <td>statement-list.html</td>
                            <td>查看项目对账单（仅拥有全部数据权限可查看）</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="subsection" id="sub-3-4">
                <div class="subsection-title">3.4 层级选择器</div>
                <table>
                    <thead>
                        <tr>
                            <th>属性</th>
                            <th>值</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>功能说明</td>
                            <td>在项目多层级结构中切换查看（项目部→工作组）</td>
                        </tr>
                        <tr>
                            <td>显示内容</td>
                            <td>层级图标 + 层级名称 + 层级类型标签</td>
                        </tr>
                        <tr>
                            <td>面包屑</td>
                            <td>显示完整路径，如：项目部 > 水电工作组</td>
                        </tr>
                        <tr>
                            <td>切换方式</td>
                            <td>点击下拉，显示所有可选层级</td>
                        </tr>
                        <tr>
                            <td>切换后</td>
                            <td>刷新页面数据，显示对应层级的合同和任务</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="subsection" id="sub-3-5">
                <div class="subsection-title">3.5 展示字段项及数量统计规则</div>
                <table>
                    <thead>
                        <tr>
                            <th>展示区域</th>
                            <th>字段项</th>
                            <th>数据来源/API</th>
                            <th>统计规则</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td rowspan="3">合同概览卡片</td>
                            <td>签约进度</td>
                            <td><code>GET /api/v1/projects/:id/contracts</code></td>
                            <td>已签约合同数 / 总合同数</td>
                        </tr>
                        <tr>
                            <td>总进度百分比</td>
                            <td><code>projects.progress</code></td>
                            <td>所有任务完成进度加权平均</td>
                        </tr>
                        <tr>
                            <td>合同数量</td>
                            <td><code>contracts.total</code></td>
                            <td>项目下所有合同总数（含各级子项目）</td>
                        </tr>
                        <tr>
                            <td rowspan="3">任务统计卡片</td>
                            <td>全部任务</td>
                            <td><code>GET /api/v1/projects/:id/tasks/stats</code></td>
                            <td>已完成任务数 / 总任务数</td>
                        </tr>
                        <tr>
                            <td>确认中任务</td>
                            <td><code>tasks.status = 'confirming'</code></td>
                            <td>状态为"确认中"的任务数量</td>
                        </tr>
                        <tr>
                            <td>执行中任务</td>
                            <td><code>tasks.status = 'in_progress'</code></td>
                            <td>状态为"执行中"的任务数量</td>
                        </tr>
                        <tr>
                            <td rowspan="2">待办事项卡片</td>
                            <td>待办数量</td>
                            <td><code>GET /api/v1/projects/:id/todos</code></td>
                            <td>当前用户待处理的待办总数</td>
                        </tr>
                        <tr>
                            <td>显示条数</td>
                            <td>前端分页</td>
                            <td>默认显示5条，点击"查看全部"跳转列表页，规格详见 <a href="PRD-任务模块详细规格.html#page-todo-list-service" target="_blank">全部待办页（服务方）</a></td>
                        </tr>
                        <tr>
                            <td rowspan="5">快捷导航栏</td>
                            <td>入口数量</td>
                            <td>前端固定配置</td>
                            <td>固定5个入口：项目信息、架构、成员、资料、对账单</td>
                        </tr>
                        <tr>
                            <td>项目信息入口</td>
                            <td>固定链接</td>
                            <td>跳转项目信息详情页</td>
                        </tr>
                        <tr>
                            <td>架构入口</td>
                            <td>固定链接</td>
                            <td>跳转项目架构树页</td>
                        </tr>
                        <tr>
                            <td>成员入口</td>
                            <td>固定链接</td>
                            <td>跳转项目成员列表页</td>
                        </tr>
                        <tr>
                            <td>资料入口</td>
                            <td>固定链接</td>
                            <td>跳转项目文件库页</td>
                        </tr>
                    </tbody>
                </table>
                <div class="note" style="margin-top: 16px;">
                    <div class="note-title">数量统计来源说明</div>
                    <p><strong>合同数量：</strong>统计当前层级及其子层级下所有合同，包括项目部层级的工作组合同、施工组合同。</p>
                    <p><strong>任务数量：</strong>统计当前层级及其子层级下所有任务包中的任务项。</p>
                    <p><strong>待办数量：</strong>仅统计当前登录用户需要处理的待办事项，不包含其他成员的待办。</p>
                </div>
            </div>

            <div class="subsection" id="sub-3-6">
                <div class="subsection-title">3.6 数据刷新规则</div>
                <table>
                    <thead>
                        <tr>
                            <th>触发场景</th>
                            <th>刷新范围</th>
                            <th>刷新方式</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>页面加载</td>
                            <td>全部数据</td>
                            <td>API请求</td>
                        </tr>
                        <tr>
                            <td>下拉刷新</td>
                            <td>全部数据</td>
                            <td>API请求 + Toast提示</td>
                        </tr>
                        <tr>
                            <td>切换层级</td>
                            <td>合同、任务、待办数据</td>
                            <td>局部刷新（骨架屏过渡）</td>
                        </tr>
                        <tr>
                            <td>返回页面</td>
                            <td>不刷新</td>
                            <td>使用缓存数据（如有）</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="subsection" id="sub-3-7">
                <div class="subsection-title">3.7 今日动态卡片规格</div>
                <table>
                    <thead>
                        <tr>
                            <th>属性</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>功能说明</td>
                            <td>展示项目的最新动态，包括任务完成、合同签署、文件上传等操作记录</td>
                        </tr>
                        <tr>
                            <td>数据来源</td>
                            <td><code>GET /api/v1/projects/:id/activities</code></td>
                        </tr>
                        <tr>
                            <td>展示方式</td>
                            <td>时间线形式，按时间倒序排列</td>
                        </tr>
                        <tr>
                            <td>默认显示条数</td>
                            <td>最新3条</td>
                        </tr>
                        <tr>
                            <td>动态内容</td>
                            <td>操作人 + 操作内容 + 时间</td>
                        </tr>
                        <tr>
                            <td>媒体支持</td>
                            <td>支持图片、视频缩略图展示</td>
                        </tr>
                        <tr>
                            <td>时间显示</td>
                            <td>今日显示"今天 HH:mm"，昨日显示"昨天"，更早显示"MM-dd"</td>
                        </tr>
                        <tr>
                            <td>查看全部动态</td>
                            <td>点击"查看全部动态"按钮，跳转到项目动态页（activity-list.html），传递当前层级参数（level=项目部/工作组/施工组）</td>
                        </tr>
                    </tbody>
                </table>
                <div class="note" style="margin-top: 12px;">
                    <div class="note-title">跳转逻辑说明</div>
                    <p><strong>跳转条件：</strong>点击"查看全部动态"按钮时触发跳转</p>
                    <p><strong>跳转目标：</strong>activity-list.html</p>
                    <p><strong>参数传递：</strong>携带当前选择的层级参数（level），用于筛选显示对应层级的动态记录</p>
                    <p><strong>页面逻辑：</strong>项目动态页接收层级参数后，自动筛选该层级下的全部动态，详见"十一、项目动态页（服务方小程序）"</p>
                </div>
            </div>

            <div class="subsection" id="sub-3-8">
                <div class="subsection-title">3.8 交互逻辑规格</div>
                <p>以下为服务方项目详情页（进行中状态）的交互逻辑规格，描述各组件的用户操作与响应行为。</p>
                <table>
                    <thead>
                        <tr>
                            <th>交互区域</th>
                            <th>交互元素</th>
                            <th>触发操作</th>
                            <th>响应行为</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td rowspan="4">导航栏</td>
                            <td>左侧"返回"按钮</td>
                            <td>点击</td>
                            <td>返回上一页（<code>history.back</code>）</td>
                        </tr>
                        <tr>
                            <td>中间标题区域</td>
                            <td>—</td>
                            <td>显示当前项目名称</td>
                        </tr>
                        <tr>
                            <td>右侧"⋯"按钮</td>
                            <td>点击</td>
                            <td>弹出操作菜单，菜单项含"分享给朋友"</td>
                        </tr>
                        <tr>
                            <td>右侧"✕"按钮</td>
                            <td>点击</td>
                            <td>关闭小程序，显示Toast提示</td>
                        </tr>
                        <tr>
                            <td rowspan="5">快捷导航</td>
                            <td>快捷入口（项目信息、架构、成员、资料、对账单）</td>
                            <td>点击</td>
                            <td>跳转对应页面</td>
                        </tr>
                        <tr>
                            <td>"固定"按钮</td>
                            <td>点击</td>
                            <td>切换固定状态；固定后快捷导航在滚动时不收起，状态通过<code>localStorage</code>持久化</td>
                        </tr>
                        <tr>
                            <td>页面向下滚动</td>
                            <td>滚动超过50px</td>
                            <td>快捷导航自动收起（用户手动展开的除外）</td>
                        </tr>
                        <tr>
                            <td>页面向上滚动</td>
                            <td>滚回顶部</td>
                            <td>快捷导航自动展开</td>
                        </tr>
                        <tr>
                            <td>展开/收起按钮</td>
                            <td>点击</td>
                            <td>切换快捷导航显示状态，文案随状态变化（"展开快捷入口"/"收起快捷入口"）</td>
                        </tr>
                        <tr>
                            <td rowspan="5">层级选择器</td>
                            <td>层级选择器区域</td>
                            <td>点击</td>
                            <td>展开下拉选项列表</td>
                        </tr>
                        <tr>
                            <td>选项列表</td>
                            <td>展示</td>
                            <td>显示当前层级、父级、子级；当前层级有勾选标记；每个选项显示层级图标+层级名称+概要信息（如"4个工作组 · 8份合同"）</td>
                        </tr>
                        <tr>
                            <td>选项项</td>
                            <td>点击</td>
