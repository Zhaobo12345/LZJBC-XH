<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>良造家管理平台 - 项目模块详细PRD规格</title>
    <style>
        :root {
            --primary-color: #1890FF;
            --success-color: #52C41A;
            --warning-color: #FA8C16;
            --error-color: #FF4D4F;
            --purple-color: #722ED1;
            --text-primary: #262626;
            --text-secondary: #595959;
            --text-tertiary: #8C8C8C;
            --border-color: #E8E8E8;
            --bg-primary: #FFFFFF;
            --bg-secondary: #FAFAFA;
            --nav-width: 280px;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.6;
            color: var(--text-primary);
            background-color: var(--bg-secondary);
        }
        /* 左侧导航栏 */
        .sidebar-nav {
            position: fixed;
            left: 0;
            top: 0;
            width: var(--nav-width);
            height: 100vh;
            background: var(--bg-primary);
            border-right: 1px solid var(--border-color);
            overflow-y: auto;
            z-index: 100;
            padding: 20px 0;
        }
        .sidebar-nav::-webkit-scrollbar { width: 6px; }
        .sidebar-nav::-webkit-scrollbar-track { background: var(--bg-secondary); }
        .sidebar-nav::-webkit-scrollbar-thumb { background: #C4C4C4; border-radius: 3px; }
        .sidebar-nav::-webkit-scrollbar-thumb:hover { background: #A0A0A0; }
        .sidebar-header {
            padding: 0 20px 20px;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 16px;
        }
        .sidebar-header .logo {
            font-size: 18px;
            font-weight: 600;
            color: var(--purple-color);
            margin-bottom: 4px;
        }
        .sidebar-header .meta {
            font-size: 12px;
            color: var(--text-tertiary);
        }
        .nav-title {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-tertiary);
            padding: 12px 20px 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .nav-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .nav-list li {
            margin: 2px 12px;
        }
        .nav-list a {
            display: block;
            padding: 10px 12px;
            border-radius: 6px;
            text-decoration: none;
            color: var(--text-secondary);
            font-size: 13px;
            transition: all 0.2s;
        }
        .nav-list a:hover {
            background: var(--bg-secondary);
            color: var(--purple-color);
        }
        .nav-list a.active {
            background: var(--purple-color);
            color: white;
        }
        .nav-divider {
            height: 1px;
            background: var(--border-color);
            margin: 12px 20px;
        }
        /* 主内容区域 */
        .main-content {
            margin-left: var(--nav-width);
            min-height: 100vh;
        }
        .container { max-width: 1200px; margin: 0 auto; padding: 24px; }
        .header {
            background: linear-gradient(135deg, #722ED1 0%, #9254DE 100%);
            color: white;
            padding: 48px 24px;
            margin-bottom: 32px;
            border-radius: 0 8px 8px 0;
        }
        .header h1 { font-size: 32px; margin-bottom: 8px; }
        .header .meta { font-size: 14px; opacity: 0.9; }
        .section {
            background: var(--bg-primary);
            border-radius: 8px;
            padding: 32px;
            margin-bottom: 24px;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        }
        .section-title {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 2px solid var(--purple-color);
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .section-title .badge {
            background: var(--purple-color);
            color: white;
            font-size: 12px;
            padding: 4px 12px;
            border-radius: 12px;
        }
        .subsection { margin-bottom: 32px; }
        .subsection-title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 16px;
            color: var(--text-primary);
        }
        /* 移除旧的页面导航样式，使用新的侧边导航 */
        .page-nav { display: none; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
        table th, table td {
            padding: 12px 16px;
            text-align: left;
            border-bottom: 1px solid var(--border-color);
            font-size: 13px;
        }
        table th { background: var(--bg-secondary); font-weight: 600; color: var(--text-secondary); }
        table td { color: var(--text-primary); }
        table tr:hover { background: var(--bg-secondary); }
        .tag {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 500;
        }
        .tag-required { background: #FFF1F0; color: var(--error-color); }
        .tag-optional { background: #F0F5FF; color: var(--primary-color); }
        .tag-system { background: #F6FFED; color: var(--success-color); }
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }
        .info-item { padding: 16px; background: var(--bg-secondary); border-radius: 6px; }
        .info-label { font-size: 12px; color: var(--text-tertiary); margin-bottom: 4px; }
        .info-value { font-size: 14px; color: var(--text-primary); font-weight: 500; }
        .info-value a {
            color: var(--purple-color);
            text-decoration: none;
            border-bottom: 1px dashed var(--purple-color);
            transition: all 0.2s;
        }
        .info-value a:hover {
            background: var(--purple-color);
            color: white;
            border-bottom-color: var(--purple-color);
        }
        .note {
            background: #FFFBE6;
            border-left: 4px solid var(--warning-color);
            padding: 12px 16px;
            margin-bottom: 24px;
            border-radius: 0 6px 6px 0;
        }
        .note-title { font-weight: 600; color: var(--warning-color); margin-bottom: 4px; }
        .code-block {
            background: #1E1E1E;
            color: #D4D4D4;
            padding: 16px;
            border-radius: 6px;
            font-family: 'Courier New', monospace;
            font-size: 13px;
            overflow-x: auto;
            margin-bottom: 24px;
        }
        /* 二级目录样式 */
        .nav-item {
            position: relative;
        }
        .nav-item > a {
            display: flex;
            align-items: center;
            padding: 8px 12px;
            border-radius: 6px;
            text-decoration: none;
            color: var(--text-secondary);
            font-size: 13px;
            transition: all 0.2s;
        }
        .nav-item > a:hover {
            background: var(--bg-secondary);
            color: var(--purple-color);
        }
        .nav-item > a.active {
            background: var(--purple-color);
            color: white;
        }
        .nav-toggle {
            display: inline-block;
            width: 16px;
            height: 16px;
            margin-right: 4px;
            transition: transform 0.2s;
            font-size: 10px;
            line-height: 16px;
            text-align: center;
            color: var(--text-tertiary);
        }
        .nav-item.collapsed .nav-toggle {
            transform: rotate(-90deg);
        }
        .nav-item.collapsed > a .nav-toggle {
            transform: rotate(-90deg);
        }
        .nav-sub {
            list-style: none;
            padding: 0;
            margin: 0;
            max-height: 500px;
            overflow: hidden;
            transition: max-height 0.3s ease, height 0.3s ease, padding 0.3s ease;
        }
        .nav-item.collapsed .nav-sub {
            max-height: 0 !important;
            height: 0 !important;
            padding-top: 0 !important;
            padding-bottom: 0 !important;
            margin-top: 0 !important;
            margin-bottom: 0 !important;
            overflow: hidden !important;
        }
        .nav-item.collapsed .nav-sub li {
            max-height: 0;
            height: 0;
            padding-top: 0;
            padding-bottom: 0;
            margin-top: 0;
            margin-bottom: 0;
            overflow: hidden;
        }
        .nav-sub li {
            margin: 0;
            padding-left: 20px;
        }
        .nav-sub a {
            display: block;
            padding: 6px 12px;
            border-radius: 4px;
            text-decoration: none;
            color: var(--text-tertiary);
            font-size: 12px;
            transition: all 0.2s;
            border-left: 2px solid transparent;
        }
        .nav-sub a:hover {
            background: var(--bg-secondary);
            color: var(--purple-color);
            border-left-color: var(--purple-color);
        }
        .nav-sub a.active {
            background: #F9F0FF;
            color: var(--purple-color);
            border-left-color: var(--purple-color);
            font-weight: 500;
        }
    </style>
</head>
