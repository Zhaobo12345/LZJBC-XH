                        <div class="info-value"><a href="service-miniapp/statement-detail.html" target="_blank">service-miniapp/statement-detail.html</a></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">适用角色</div>
                        <div class="info-value">项目总、工长</div>
                    </div>
                    <div class="info-item">
