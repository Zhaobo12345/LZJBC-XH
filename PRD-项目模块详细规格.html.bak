            <p style="font-size: 12px; margin-top: 8px;">下一步将输出其他模块规格</p>
        </div>
        </div>
    </div>

    <script>
        // ===== 侧边栏展开/收起交互 =====
        // 注意：HTML 中已默认添加 class="collapsed"，确保在 JS 加载前即为收起状态
        const navItems = document.querySelectorAll('.nav-item');
        const userCollapsed = new Set();
        
        // 从 localStorage 恢复用户上次展开的项
        navItems.forEach(item => {
            const subList = item.querySelector('.nav-sub');
            if (!subList) return;
            
            const saved = localStorage.getItem('nav-expanded-' + item.id);
            if (saved === 'true') {
                item.classList.remove('collapsed');
            }
        });
        
        // 点击一级导航项：展开/收起二级目录
        navItems.forEach(item => {
            const link = item.querySelector(':scope > a');
            const subList = item.querySelector('.nav-sub');
            if (!subList) return;
            
            link.addEventListener('click', function(e) {
                e.preventDefault();
                
                const isCollapsed = item.classList.contains('collapsed');
                const targetId = this.getAttribute('href').substring(1);
                const target = document.getElementById(targetId);
                
                if (isCollapsed) {
                    item.classList.remove('collapsed');
                    userCollapsed.delete(item.id);
                    localStorage.setItem('nav-expanded-' + item.id, 'true');
                    if (target) {
                        const offsetTop = target.offsetTop - 20;
                        setTimeout(() => {
                            window.scrollTo({ top: offsetTop, behavior: 'smooth' });
                        }, 250);
                    }
                } else {
                    item.classList.add('collapsed');
                    userCollapsed.add(item.id);
                    localStorage.setItem('nav-expanded-' + item.id, 'false');
                }
            });
        });
        
        // ===== 滚动监听 - 自动高亮当前section =====
        const sections = document.querySelectorAll('.section[id]');
        const subSections = document.querySelectorAll('.subsection[id]');
        const allNavLinks = document.querySelectorAll('.nav-list a');
        let isInitialRun = true;
        
        function updateActiveNav() {
            const scrollPos = window.scrollY + 150;
            let currentSection = '';
            let currentSubSection = '';
            
            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                const sectionHeight = section.offsetHeight;
                if (scrollPos >= sectionTop && scrollPos < sectionTop + sectionHeight) {
                    currentSection = section.getAttribute('id');
                }
            });
            
            subSections.forEach(sub => {
                const subTop = sub.offsetTop;
                const subHeight = sub.offsetHeight;
                if (scrollPos >= subTop && scrollPos < subHeight) {
                    currentSubSection = sub.getAttribute('id');
                }
            });
            
            allNavLinks.forEach(link => {
                link.classList.remove('active');
                const href = link.getAttribute('href');
                if (href === '#' + currentSection) {
                    link.classList.add('active');
                    // 滚动时自动展开：仅在用户未显式收起该项时
                    if (!isInitialRun) {
                        const navItem = link.closest('.nav-item');
                        if (navItem && navItem.classList.contains('collapsed') && !userCollapsed.has(navItem.id)) {
                            navItem.classList.remove('collapsed');
                            localStorage.setItem('nav-expanded-' + navItem.id, 'true');
                        }
                    }
                }
                if (href === '#' + currentSubSection) {
                    link.classList.add('active');
                }
            });
        }
        
        // ===== 二级链接点击平滑滚动 =====
        const subNavLinks = document.querySelectorAll('.nav-sub a');
        subNavLinks.forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const targetId = this.getAttribute('href').substring(1);
                const target = document.getElementById(targetId);
                if (target) {
                    const navItem = link.closest('.nav-item');
                    if (navItem) {
                        navItem.classList.remove('collapsed');
                        userCollapsed.delete(navItem.id);
                        localStorage.setItem('nav-expanded-' + navItem.id, 'true');
                    }
                    const offsetTop = target.offsetTop - 20;
                    window.scrollTo({ top: offsetTop, behavior: 'smooth' });
                }
            });
        });
        
        window.addEventListener('scroll', updateActiveNav);
        // 初始化时只高亮，不自动展开
        updateActiveNav();
        isInitialRun = false;
    </script>

    <!-- 文档结束 -->
    <div style="text-align: center; padding: 48px 0; color: var(--text-tertiary); margin-left: var(--nav-width);">
        <p>— 项目模块规格结束 —</p>
        <p style="font-size: 12px; margin-top: 8px;">返回 <a href="PRD-完整文档.html" style="color: var(--purple-color);">完整文档</a></p>
    </div>
</body>
</html>