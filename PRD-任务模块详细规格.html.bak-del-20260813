    <!-- 滚动高亮脚本 -->
    <script>
        (function () {
            const list = document.querySelector('.sidebar-toc-list');
            if (!list) return;

            const isChapter = li => li.tagName === 'LI' && li.querySelector('a')
                && !li.classList.contains('toc-sub') && !li.classList.contains('toc-group-title');
            const children = Array.from(list.children);
            const chapters = children.filter(isChapter);
            const groups = children.filter(li => li.classList.contains('toc-group-title'));

            // 为每个一级章节收集其下二级目录，并插入折叠指示器
            chapters.forEach(ch => {
                const subs = [];
                let n = ch.nextElementSibling;
                while (n && n.classList && n.classList.contains('toc-sub')) {
                    subs.push(n);
                    n = n.nextElementSibling;
                }
                ch._subs = subs;
                const a = ch.querySelector('a');
                const tog = document.createElement('span');
                tog.className = 'toc-toggle';
                tog.textContent = '▸';
                a.insertBefore(tog, a.firstChild);
                ch._toggle = tog;
            });

            function setChapterCollapsed(ch, collapsed) {
                ch.classList.toggle('toc-chapter-collapsed', collapsed);
                ch._toggle.textContent = collapsed ? '▸' : '▾';
                ch._subs.forEach(s => s.style.display = collapsed ? 'none' : '');
            }

            // 折叠指示器点击：仅切换，不触发跳转
            chapters.forEach(ch => {
                ch._toggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    setChapterCollapsed(ch, !ch.classList.contains('toc-chapter-collapsed'));
                });
            });

            // 分组标题：整体折叠 / 展开其下所有章节（默认收起）
            groups.forEach(g => {
                g.classList.add('toc-group-collapsed');
                const chs = [];
                let n = g.nextElementSibling;
                while (n && !n.classList.contains('toc-group-title')) {
                    if (chapters.indexOf(n) !== -1) chs.push(n);
                    n = n.nextElementSibling;
                }
                g._chapters = chs;
                const gtog = document.createElement('span');
                gtog.className = 'toc-toggle';
                gtog.textContent = '▸';
                g.insertBefore(gtog, g.firstChild);
                g.addEventListener('click', function () {
                    const willCollapse = !g.classList.contains('toc-group-collapsed');
                    g.classList.toggle('toc-group-collapsed', willCollapse);
                    gtog.textContent = willCollapse ? '▸' : '▾';
                    chs.forEach(ch => setChapterCollapsed(ch, willCollapse));
                });
            });

            // 所有链接：平滑跳转（一级章节标题链接除外，单独处理）
            const links = Array.from(list.querySelectorAll('a'));
            links.forEach(link => {
                const li = link.closest('li');
                if (li && isChapter(li)) return; // 一级章节标题单独处理
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    const id = link.getAttribute('href').substring(1);
                    const el = document.getElementById(id);
                    if (el) window.scrollTo({ top: el.offsetTop - 20, behavior: 'smooth' });
                });
            });

            // 章节标题点击：切换折叠 / 展开（展开时同步跳转章节，收起时不滚动）
            chapters.forEach(ch => {
                const a = ch.querySelector('a');
                a.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const willCollapse = !ch.classList.contains('toc-chapter-collapsed');
                    setChapterCollapsed(ch, willCollapse);
                    if (!willCollapse) {
                        const id = a.getAttribute('href').substring(1);
                        const el = document.getElementById(id);
                        if (el) window.scrollTo({ top: el.offsetTop - 20, behavior: 'smooth' });
                    }
                });
            });

            // 默认全部收起
            chapters.forEach(ch => setChapterCollapsed(ch, true));

            // 滚动高亮 + 自动展开当前所属章节
            function updateActiveToc() {
                const scrollPos = window.scrollY || window.pageYOffset;
                let activeLink = links[0];
                links.forEach(link => {
                    const id = link.getAttribute('href').substring(1);
                    const el = document.getElementById(id);
                    if (el && (el.offsetTop - 120) <= scrollPos) activeLink = link;
                });
                links.forEach(l => l.classList.remove('active'));
                if (activeLink) activeLink.classList.add('active');
                if (activeLink) {
                    const li = activeLink.closest('li');
                    if (li && li.classList.contains('toc-sub')) {
                        let p = li.previousElementSibling;
                        while (p && !isChapter(p)) p = p.previousElementSibling;
                        if (p && p.classList.contains('toc-chapter-collapsed')) setChapterCollapsed(p, false);
                    }
                }
            }
            window.addEventListener('scroll', updateActiveToc);
            updateActiveToc();
        })();
    </script>
