        a.proto-link {
            color: var(--primary-color);
            text-decoration: none;
            border-bottom: 1px dashed var(--primary-color);
            cursor: pointer;
        }

        .subsection { margin-bottom: 32px; }
        .subsection-title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 16px;
            color: var(--text-primary);
        }

        table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
        table th, table td {
            padding: 12px 16px;
            text-align: left;
            border-bottom: 1px solid var(--border-color);
            font-size: 13px;
        }
        table th { background: var(--bg-secondary); font-weight: 600; color: var(--text-secondary); }
        table td { color: var(--text-primary); }
        table tr:hover { background: var(--bg-secondary); }
        .tag {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 500;
        }
        .tag-required { background: #FFF1F0; color: var(--error-color); }
        .tag-optional { background: #F0F5FF; color: var(--primary-color); }
        .tag-system { background: #F6FFED; color: var(--success-color); }
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }
        .info-item { padding: 16px; background: var(--bg-secondary); border-radius: 6px; }
        .info-label { font-size: 12px; color: var(--text-tertiary); margin-bottom: 4px; }
        .info-value { font-size: 14px; color: var(--text-primary); font-weight: 500; }
        .note {
            background: #FFFBE6;
            border-left: 4px solid var(--warning-color);
            padding: 12px 16px;
            margin-bottom: 24px;
            border-radius: 0 6px 6px 0;
        }
        .note-title { font-weight: 600; color: var(--warning-color); margin-bottom: 4px; }
        .code-block {
            background: #1E1E1E;
            color: #D4D4D4;
            padding: 16px;
            border-radius: 6px;
            font-family: 'Courier New', monospace;
            font-size: 13px;
            overflow-x: auto;
            margin-bottom: 24px;
        }
        .flow-diagram {
            background: var(--bg-secondary);
            padding: 24px;
            border-radius: 6px;
            text-align: center;
            margin-bottom: 24px;
        }
        .flow-step {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin: 8px;
        }
        .flow-step .box {
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 500;
        }
        .flow-step .box.active { background: var(--success-color); color: white; }
        .flow-step .box.passive { background: white; border: 1px solid var(--border-color); color: var(--text-tertiary); }
        .flow-step .arrow { color: var(--text-tertiary); }
    </style>
